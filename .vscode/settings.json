{
  // Hide generated folders from the explorer. They are not deleted — they are
  // just noise. Everything hidden here is rebuilt by `npm install` / `npm run build`.
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/.vercel": true
  },

  // Do not waste time searching 15,000 dependency files.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/package-lock.json": true
  },

  // Do not watch them either — this is most of VS Code's CPU use on Node projects.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.astro/**": true
  },

  // Collapse config files under package.json, so the root shows folders and
  // README instead of a wall of dotfiles. Click the arrow to expand.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig.json, vitest.config.ts, astro.config.mjs, .gitignore, .env, .env.example",
    "README.md": "CLAUDE.md",
    "*.ts": "$(capture).test.ts"
  },

  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
