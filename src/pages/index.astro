---
/**
 * The homepage: a portrait, a short introduction, and the most recent things
 * she has written and researched.
 *
 * Both the sites this was modelled on lead with a photo and a few sentences,
 * then list recent work — the page should tell a stranger who is writing and
 * what she works on without them clicking anything.
 *
 * Everything below the intro appears on its own as content is added. With no
 * articles yet the page is just the introduction, which is the right thing for
 * it to be.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, activeLinks } from '../data/site';
import { publishedByNewest, formatDate, toISODate, displayYear, provenance } from '../lib/content';

const recentWriting = publishedByNewest(await getCollection('writing')).slice(0, 4);
const recentResearch = publishedByNewest(await getCollection('research')).slice(0, 3);
---

<Base description={site.intro}>
  <div class="profile">
    {
      site.portrait && (
        <img class="profile__portrait" src={site.portrait} alt={site.portraitAlt} width="400" height="400" />
      )
    }

    <div class="profile__body">
      <h1>{site.name}</h1>
      <p class="profile__role">{site.tagline}</p>

      {site.homeIntro.map((paragraph) => <p class="profile__intro">{paragraph}</p>)}

      {
        activeLinks.length > 0 && (
          <ul class="profile__links">
            {activeLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {
    recentWriting.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>Recent writing</h2>
          <a class="section__more" href="/writing/">
            All writing →
          </a>
        </div>
        <ul class="home-list">
          {recentWriting.map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>
                <h3>{post.data.title}</h3>
              </a>
              <p class="home-list__summary">{post.data.summary}</p>
              <p class="home-list__meta">
                <time datetime={toISODate(post.data.date)}>{formatDate(post.data.date)}</time>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    recentResearch.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>Research</h2>
          <a class="section__more" href="/research/">
            All research →
          </a>
        </div>
        <ul class="home-list">
          {recentResearch.map((entry) => (
            <li>
              <a href={`/research/${entry.id}/`}>
                <h3>{entry.data.title}</h3>
              </a>
              <p class="home-list__summary">{entry.data.summary}</p>
              <p class="home-list__meta">
                <span>{displayYear(entry.data)}</span>
                <span class="dot">{provenance(entry.data)}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
