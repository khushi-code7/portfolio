---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { publishedByNewest } from '../lib/content';
import { activeLinks, site } from '../data/site';

const allProjects = publishedByNewest(await getCollection('projects'));
// Featured projects lead; if nothing is pinned, fall back to the three newest.
const pinned = allProjects.filter((p) => p.data.featured);
const projects = (pinned.length > 0 ? pinned : allProjects).slice(0, 3);

const posts = publishedByNewest(await getCollection('writing')).slice(0, 3);
---

<Base>
  <div class="page-head">
    <h1>{site.greeting}</h1>
    <p class="lede" style="margin-top:0.75rem">{site.tagline}</p>
  </div>

  <p style="max-width:var(--measure)">{site.intro}</p>

  {
    activeLinks.length > 0 && (
      <div class="link-row">
        {activeLinks.map((link) => (
          <a class="button" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    )
  }

  <section class="section">
    <div class="section__head">
      <h2>Selected work</h2>
      <a class="section__more" href="/projects/">All work →</a>
    </div>
    <EntryList
      entries={projects.map((p) => ({
        href: `/projects/${p.id}/`,
        title: p.data.title,
        summary: p.data.summary,
        date: p.data.date,
        tags: p.data.tags,
      }))}
      emptyMessage="No projects published yet."
    />
  </section>

  <section class="section">
    <div class="section__head">
      <h2>Writing</h2>
      <a class="section__more" href="/writing/">All writing →</a>
    </div>
    <EntryList
      entries={posts.map((p) => ({
        href: `/writing/${p.id}/`,
        title: p.data.title,
        summary: p.data.summary,
        date: p.data.date,
        tags: p.data.tags,
      }))}
      emptyMessage="No posts published yet."
    />
  </section>
</Base>
