---
/**
 * The homepage. It answers, in order:
 *
 *   who         circular photo, name, icon links
 *   what        one-line research statement — the line that does the work
 *   who, longer the bio, and a "Currently" line
 *   proof       Research, then Writing
 *
 * Research comes before Writing on purpose: this is an academic page that also
 * carries essays, not a blog with a CV attached.
 *
 * Both lists build themselves — publishing a file puts it at the top — and a
 * section with nothing in it is not rendered at all rather than announcing its
 * own emptiness. This page never needs editing to add a paper or a piece.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IconLink from '../components/IconLink.astro';
import { site } from '../data/site';
import { publishedByNewest, readingTime, displayYear, provenance } from '../lib/content';

/**
 * The homepage shows the most recent of each and links through to the full
 * list. A homepage that prints the whole archive stops being an introduction,
 * and it makes "All writing" a lie.
 */
const SHOWN = 4;

const research = publishedByNewest(await getCollection('research')).slice(0, SHOWN);
const pieces = publishedByNewest(await getCollection('writing')).slice(0, SHOWN);

const linkFor = (label: string) => site.links.find((link) => link.label === label)?.href ?? '';
---

<Base description={site.intro}>
  <header class="identity">
    {
      site.portrait && (
        <img class="identity__photo" src={site.portrait} alt={site.portraitAlt} width="400" height="400" />
      )
    }
    <div>
      <h1 class="identity__name">{site.name}</h1>
      <div class="icon-links">
        <IconLink href={linkFor('Email')} label="Email" icon="mail" />
        <IconLink href={linkFor('LinkedIn')} label="LinkedIn" icon="linkedin" />
      </div>
    </div>
  </header>

  {site.researchLine && <p class="statement">{site.researchLine}</p>}

  <section class="about" aria-label="About">
    {site.homeIntro.map((paragraph) => <p>{paragraph}</p>)}
    {
      site.currently && (
        <p class="about__now">
          <span class="about__now-label">Currently</span>
          {site.currently}
        </p>
      )
    }
  </section>

  {
    research.length > 0 && (
      <section class="home-section" aria-labelledby="research-heading">
        <div class="home-section__head">
          <h2 id="research-heading">Research</h2>
          <a class="section__more" href="/research/">
            All research
          </a>
        </div>

        <ul class="article-list">
          {research.map((entry) => (
            <li class="article">
              <span class="article__dot" aria-hidden="true" />
              <div class="article__text">
                <h3>
                  <a href={`/research/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.summary}</p>
                <p class="article__meta">
                  {displayYear(entry.data)} · {provenance(entry.data)}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    pieces.length > 0 && (
      <section class="home-section" aria-labelledby="writing-heading">
        <div class="home-section__head">
          <h2 id="writing-heading">Writing</h2>
          <a class="section__more" href="/writing/">
            All writing
          </a>
        </div>

        <ul class="article-list">
          {pieces.map((piece) => (
            <li class="article">
              <span class="article__dot" aria-hidden="true" />
              <div class="article__text">
                <h3>
                  <a href={`/writing/${piece.id}/`}>{piece.data.title}</a>
                </h3>
                <p>{piece.data.summary}</p>
                <p class="article__meta">{readingTime(piece.body ?? '')} min read</p>
              </div>
              {piece.data.thumbnail && (
                <img class="article__thumb" src={piece.data.thumbnail} alt="" width="240" height="160" />
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
