---
/**
 * The homepage, built from your sketch.
 *
 *   nav top right      Contact | CV | Articles
 *   circular photo     with your name beside it
 *   icon links         envelope and LinkedIn, hidden until they have addresses
 *   About box          a bordered panel
 *   Articles           title, summary, and an optional thumbnail
 *
 * Articles list themselves — publishing one puts it at the top. This page never
 * needs editing to add a piece of writing.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IconLink from '../components/IconLink.astro';
import { site } from '../data/site';
import { publishedByNewest } from '../lib/content';

const articles = publishedByNewest(await getCollection('articles'));

const linkFor = (label: string) => site.links.find((link) => link.label === label)?.href ?? '';
---

<Base description={site.intro}>
  <header class="identity">
    {
      site.portrait && (
        <img class="identity__photo" src={site.portrait} alt={site.portraitAlt} width="400" height="400" />
      )
    }
    <div>
      <h1 class="identity__name">{site.name}</h1>
      <div class="icon-links">
        <IconLink href={linkFor('Email')} label="Email" icon="mail" />
        <IconLink href={linkFor('LinkedIn')} label="LinkedIn" icon="linkedin" />
      </div>
    </div>
  </header>

  <section class="about-box" aria-label="About">
    {site.homeIntro.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="articles">
    <h2>Articles</h2>

    {
      articles.length === 0 ? (
        <p class="empty">Nothing published yet.</p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li class="article">
              <span class="article__dot" aria-hidden="true" />
              <div class="article__text">
                <h3>
                  <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                </h3>
                <p>{article.data.summary}</p>
              </div>
              {article.data.thumbnail && (
                <img class="article__thumb" src={article.data.thumbnail} alt="" width="240" height="160" />
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
