---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base bare>
  <div class="landing">
    <h1 class="landing__title">{site.greeting}</h1>
    <p class="landing__note">Website coming soon</p>
  </div>
</Base>

<style>
  /* Full-viewport centred hero. Nothing else on the page, so the layout
     lives here rather than in global.css. */
  .landing {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: var(--gutter);
    text-align: center;
  }

  .landing__title {
    margin: 0;
    max-width: 20ch;
    /* Big on desktop, still comfortable on a narrow phone. */
    font-size: clamp(2.25rem, 8vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .landing__note {
    margin: 0;
    color: var(--text-muted);
    opacity: 0.6;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }
</style>
