---
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { publishedByNewest } from '../../lib/content';

const posts = publishedByNewest(await getCollection('writing'));

const description = 'Writing by Khushi Bajaj.';
---

<Base title="Writing" description={description}>
  <div class="page-head">
    <h1>Writing</h1>
    <p>
      {description} Posted whenever one is ready. Follow by <a href="/rss.xml">RSS</a>.
    </p>
  </div>

  <EntryList
    entries={posts.map((p) => ({
      href: `/writing/${p.id}/`,
      title: p.data.title,
      summary: p.data.summary,
      date: p.data.date,
      tags: p.data.tags,
    }))}
    emptyMessage="The first pieces are on their way."
  />
</Base>
