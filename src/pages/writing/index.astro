---
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import SpineRack from '../../components/SpineRack.astro';
import { publishedByNewest, readingTime } from '../../lib/content';

const posts = publishedByNewest(await getCollection('writing'));

const description = 'Writing by Khushi Bajaj.';
---

<Base title="Writing" description={description}>
  <div class="page-head">
    <h1>Writing</h1>
    <p>
      {description} Posted whenever one is ready. Follow by <a href="/rss.xml">RSS</a>.
    </p>
  </div>

  <SpineRack
    entries={posts.map((p) => ({
      href: `/writing/${p.id}/`,
      title: p.data.title,
      summary: p.data.summary,
      date: p.data.date,
      minutes: readingTime(p.body ?? ''),
    }))}
    emptyMessage="The first pieces are on their way."
  />
</Base>
