---
/**
 * The CV — "left rail" layout. Section names sit in a fixed left column, the
 * entries fill the right.
 *
 * Everything comes from `src/data/cv.ts` and the research collection; there is
 * no second copy of any of it. Printing this page (Ctrl/Cmd+P) gives the PDF,
 * so the two can never disagree.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CvSection from '../components/CvSection.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import {
  profile,
  skills,
  languages,
  sectionsBeforeResearch,
  sectionsAfterResearch,
} from '../data/cv';
import { publishedByNewest, displayYear } from '../lib/content';

const papers = publishedByNewest(await getCollection('research'));
---

<Base title="CV" description={site.intro}>
  <article class="cv">
    <header class="cv-masthead">
      <h1>{profile.name}</h1>
      <p class="cv-masthead__strap">{profile.strapline}</p>
      <p class="cv-masthead__contact">
        <span>{profile.location}</span>
        <a
          class="cv-contact"
          href={`mailto:${profile.email}`}
          aria-label={`Email ${profile.email}`}
          title={profile.email}
        >
          <Icon name="mail" class="cv-contact__icon" />
          <span class="print-only">{profile.email}</span>
        </a>
        <a
          class="cv-contact"
          href={profile.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`LinkedIn — ${profile.linkedin.label}`}
          title={profile.linkedin.label}
        >
          <Icon name="linkedin" class="cv-contact__icon" />
          <span class="print-only">{profile.linkedin.label}</span>
        </a>
        {profile.phone && <span class="print-only">{profile.phone}</span>}
      </p>
    </header>

    <p class="cv-actions screen-only">
      <button type="button" class="button" data-print>Save this page as a PDF</button>
      <span class="cv-hint">or press Ctrl / Cmd + P</span>
    </p>

    {sectionsBeforeResearch.map((section) => <CvSection section={section} />)}

    <section class="cv-band" id="papers">
      <h2>Papers presented</h2>
      <div>
        {
          papers.map((paper) => (
            <div class="cv-entry">
              <div class="cv-entry__main">
                <p class="cv-entry__title">
                  <a href={`/research/${paper.id}/`}>{paper.data.title}</a>
                </p>
                {paper.data.venue && <p class="cv-entry__where">{paper.data.venue}</p>}
                <p class="cv-entry__note">{paper.data.summary}</p>
              </div>
              <p class="cv-entry__when">{displayYear(paper.data)}</p>
            </div>
          ))
        }
      </div>
    </section>

    {sectionsAfterResearch.map((section) => <CvSection section={section} />)}

    <section class="cv-band" id="skills">
      <h2>Skills</h2>
      <div>
        {
          skills.map((group) => (
            <p class="cv-plain">
              <b>{group.group}</b> — {group.text}
            </p>
          ))
        }
      </div>
    </section>

    <section class="cv-band" id="languages">
      <h2>Languages</h2>
      <div>
        <p class="cv-plain">{languages}</p>
      </div>
    </section>
  </article>
</Base>

<script>
  // The only script on the site. Without it the page still works — the hint
  // beside the button gives the keyboard shortcut.
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
