---
/**
 * Contact.
 *
 * The address and the "Elsewhere" list come from `src/data/site.ts` — there is
 * no second copy of either here. Adding a profile link there adds it below.
 */
import Base from '../layouts/Base.astro';
import { site, activeLinks } from '../data/site';

const description = 'How to reach Khushi Bajaj — marketing and consumer behaviour.';
const hasEmail = !site.email.startsWith('[');
---

<Base title="Contact" description={description}>
  <div class="page-head">
    <h1>Contact</h1>
    <p>Email is the surest way to reach me.</p>
  </div>

  <div class="prose">
    <p>
      {hasEmail ? <a href={`mailto:${site.email}`}>{site.email}</a> : site.email}
    </p>

    <p>I am glad to hear from you if you are:</p>
    <ul>
      <li>working on consumer behaviour, or on marketing research more broadly</li>
      <li>looking for a teaching or research collaborator</li>
      <li>responding to something I have written here</li>
    </ul>

    {
      activeLinks.length > 0 && (
        <>
          <h2>Elsewhere</h2>
          <ul>
            {activeLinks
              .filter((link) => link.label !== 'Email')
              .map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
          </ul>
        </>
      )
    }
  </div>
</Base>
