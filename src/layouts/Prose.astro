---
import Base from './Base.astro';

/**
 * Layout for standalone Markdown pages in src/pages (About, colophon, uses…).
 *
 * Astro hands a Markdown page's frontmatter to its layout as a single
 * `frontmatter` prop — not as top-level props. Reading them directly gives you
 * an empty <h1> and no page title, and nothing warns you about it, so the
 * fallback below is deliberate: a missing title should be obvious on the page.
 */
interface Frontmatter {
  title: string;
  description?: string;
  lede?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { title, description, lede } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <div class="page-head">
    <h1>{title}</h1>
    {lede && <p>{lede}</p>}
  </div>
  <div class="prose">
    <slot />
  </div>
</Base>
