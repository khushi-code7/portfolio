---
/**
 * The writing archive drawn as a stack of books lying flat.
 *
 * Each piece is a book on its side. Its length and its thickness are both its
 * reading time; its cloth is its age. The newest sits at the top left and every
 * one after it sits directly on the book above and a step to the right, so the
 * stack runs from the top left down to the right.
 *
 * Point at a book — or tab to it — and it slides out of the stack while its
 * note appears beside it. Nothing is revealed by JavaScript: it is :hover and
 * :focus, so it works from the keyboard and with scripting off.
 *
 * On a phone, or any pointer that cannot hover, the stack becomes a plain
 * column of bars with the notes already open, because there is no hover to
 * discover them with.
 */
import { formatDate, toISODate } from '../lib/content';
import { formatDuration, stack, totalMinutes } from '../lib/rack';

export interface RackItem {
  href: string;
  title: string;
  summary: string;
  date: Date;
  /** Reading time in whole minutes. */
  minutes: number;
}

interface Props {
  entries: RackItem[];
  /** Shown in place of the stack when there is nothing in it. */
  emptyMessage?: string;
}

const { entries, emptyMessage = 'Nothing here yet.' } = Astro.props;

const books = stack(entries);
const total = formatDuration(totalMinutes(entries));
const count = `${entries.length} ${entries.length === 1 ? 'piece' : 'pieces'}`;
---

{
  books.length === 0 ? (
    <p class="empty">{emptyMessage}</p>
  ) : (
    <div class="rack">
      <div class="rack__case">
        <ul class="rack__shelf">
          {books.map((book) => (
            <li style={`--book-x:${book.x}rem`}>
              <a
                class="spine"
                href={book.href}
                style={`--book-l:${book.length}rem;--book-t:${book.thickness}rem;--spine-face:var(--spine-${book.tint});--spine-ink:var(--spine-${book.tint}-ink)`}
              >
                {/* The book is what slides out. The note must sit outside it: a
                    transformed element becomes the containing block for
                    anything absolute inside it, which would nail the note to
                    the book instead of the page. */}
                <span class="spine__book">
                  <span class="spine__bands" aria-hidden="true" />
                  <span class="spine__title">{book.title}</span>
                  <span class="spine__mins">{book.minutes} min read</span>
                  <span class="spine__pages" aria-hidden="true" />
                </span>

                <span class="spine__card">
                  <span class="spine__card-title">{book.title}</span>
                  <span class="spine__card-summary">{book.summary}</span>
                  <span class="spine__card-meta">
                    <span class="spine__badge">{book.minutes} min read</span>
                    <time datetime={toISODate(book.date)}>{formatDate(book.date)}</time>
                  </span>
                  <span class="spine__card-go">Read →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="rack__plank" aria-hidden="true" />

      <p class="rack__caption">
        <span>
          {count} · {total} of reading · longer pieces are longer books
        </span>
        <span class="rack__hint">Point at a book, or press Tab</span>
      </p>
    </div>
  )
}
