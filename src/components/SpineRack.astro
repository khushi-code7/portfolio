---
/**
 * The writing archive drawn as a shelf of books.
 *
 * Each piece is a spine standing on the shelf: its size is its reading time and
 * its tint is its age. Point at one — or tab to it — and it lifts out of the
 * rack while its note appears in the space beside the shelf. Nothing is
 * revealed by JavaScript: it is :hover and :focus-within, so it works from the
 * keyboard and it works with scripting off.
 *
 * The shelf stands up at every width. Its books are sized in `--spine-unit`
 * rather than in rem, and that unit shrinks until the whole shelf fits the
 * screen it is on, so a phone gets the same bookcase as a desktop, only
 * smaller. Where there is no hover the note cannot open, so a tap goes
 * straight to the piece.
 */
import { formatDate, toISODate } from '../lib/content';
import { formatDuration, rack, totalMinutes } from '../lib/rack';

export interface RackItem {
  href: string;
  title: string;
  summary: string;
  date: Date;
  /** Reading time in whole minutes. */
  minutes: number;
}

interface Props {
  entries: RackItem[];
  /** Shown in place of the shelf when there is nothing on it. */
  emptyMessage?: string;
}

/** The gap between two books, in px. Must match `.rack__shelf` in global.css. */
const SHELF_GAP = 4;

const { entries, emptyMessage = 'Nothing here yet.' } = Astro.props;

const spines = rack(entries);
const total = formatDuration(totalMinutes(entries));
const count = `${entries.length} ${entries.length === 1 ? 'piece' : 'pieces'}`;

/**
 * The shelf measured in `--spine-unit`s, and the fixed pixels its gaps take.
 * Together they are what lets the CSS work out how small the unit has to be
 * for the whole bookcase to fit the screen.
 */
const shelfWidth = Math.round(spines.reduce((sum, spine) => sum + spine.width, 0) * 100) / 100;
const gaps = Math.max(0, spines.length - 1) * SHELF_GAP;
---

{
  spines.length === 0 ? (
    <p class="empty">{emptyMessage}</p>
  ) : (
    <div class="rack" style={`--rack-w:${shelfWidth};--rack-gaps:${gaps}px`}>
      <div class="rack__case">
        <ul class="rack__shelf">
          {spines.map((spine) => (
            <li>
              <a
                class="spine"
                href={spine.href}
                style={`--spine-w:${spine.width};--spine-h:${spine.height}%;--spine-face:var(--spine-${spine.tint});--spine-ink:var(--spine-${spine.tint}-ink)`}
              >
                {/* The book is what lifts. The note must sit outside it: a
                    transformed element becomes the containing block for
                    anything absolute inside it, which would nail the note to
                    the spine instead of the shelf. */}
                <span class="spine__book">
                  <span class="spine__bands" aria-hidden="true" />
                  <span class="spine__title">{spine.title}</span>
                  <span class="spine__mins">{spine.minutes} min read</span>
                </span>

                <span class="spine__card">
                  <span class="spine__card-title">{spine.title}</span>
                  <span class="spine__card-summary">{spine.summary}</span>
                  <span class="spine__card-meta">
                    <span class="spine__badge">{spine.minutes} min read</span>
                    <time datetime={toISODate(spine.date)}>{formatDate(spine.date)}</time>
                  </span>
                  <span class="spine__card-go">Read →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="rack__plank" aria-hidden="true" />

      <p class="rack__caption">
        <span>
          {count} · {total} of reading · wider and taller means longer
        </span>
        <span class="rack__hint">Point at a book, or press Tab</span>
        <span class="rack__hint rack__hint--tap">Tap a book to read it</span>
      </p>
    </div>
  )
}
