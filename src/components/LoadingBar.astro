---
/**
 * A thin progress bar across the top of the viewport while the browser fetches
 * the next page.
 *
 * Why a bar and not a splash screen: pages here are static HTML with no
 * client-side render step, so on a normal connection the next page paints
 * before a spinner could finish its first frame. A full-screen "loading…"
 * would add waiting rather than explain it. This shows up only once a
 * navigation has already taken longer than SHOW_AFTER_MS, so it is invisible
 * on a fast connection and does real work on a slow one.
 *
 * There is deliberately nothing here for the very first page load — by the time
 * any script of ours runs, the HTML is already parsed and on screen.
 *
 * aria-hidden: browsers announce page loads to assistive tech themselves, so
 * this is decoration. Duplicating it in the accessibility tree would only add
 * noise.
 */
---

<div id="loading-bar" class="loading-bar" aria-hidden="true"></div>

<style>
  .loading-bar {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 200; /* above the skip link */
    width: 0;
    height: 3px;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms linear;
  }

  /*
    Eases towards 92% and stops. It never reaches the end on its own: the bar
    disappears because the new page replaced this one, which is the only honest
    signal we have. Front-loading the movement means a slow load still looks
    like progress rather than a stalled bar.
  */
  .loading-bar.is-loading {
    opacity: 1;
    animation: loading-bar-advance 12s cubic-bezier(0, 0.75, 0.25, 1) forwards;
  }

  @keyframes loading-bar-advance {
    from {
      width: 0;
    }
    to {
      width: 92%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-bar {
      transition: none;
    }

    /* Presence, not movement. */
    .loading-bar.is-loading {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  import { startsPageLoad } from '../lib/nav-progress';

  const bar = document.getElementById('loading-bar');

  if (bar) {
    /** Below this, a navigation reads as instant and a flash of bar would only make it feel slower. */
    const SHOW_AFTER_MS = 150;
    /** If a load is cancelled we never hear about it — don't leave the bar up forever. */
    const GIVE_UP_AFTER_MS = 20_000;

    let showTimer: number | undefined;
    let giveUpTimer: number | undefined;

    function show() {
      if (showTimer !== undefined) return; // already waiting on a navigation
      showTimer = window.setTimeout(() => {
        bar!.classList.add('is-loading');
      }, SHOW_AFTER_MS);
      giveUpTimer = window.setTimeout(hide, GIVE_UP_AFTER_MS);
    }

    function hide() {
      window.clearTimeout(showTimer);
      window.clearTimeout(giveUpTimer);
      showTimer = undefined;
      giveUpTimer = undefined;
      bar!.classList.remove('is-loading');
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      const link = target instanceof Element ? target.closest('a') : null;
      if (!link) return;

      if (
        startsPageLoad({
          href: link.href,
          from: window.location.href,
          target: link.getAttribute('target'),
          download: link.hasAttribute('download'),
          button: event.button,
          modified: event.metaKey || event.ctrlKey || event.shiftKey || event.altKey,
          defaultPrevented: event.defaultPrevented,
        })
      ) {
        show();
      }
    });

    /*
      A page restored from the back/forward cache comes back with the DOM it was
      frozen with — including a half-finished bar from the click that left it.
      pageshow fires on restore as well as first load, so this clears both.
    */
    window.addEventListener('pageshow', hide);
  }
</script>
