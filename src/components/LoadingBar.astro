---
/**
 * A hairline across the bottom of the viewport.
 *
 * It is always there as a faint accent-tinted track — quiet enough to read as
 * part of the furniture rather than a widget. When you click through to another
 * page, the track fills with accent colour and sweeps right.
 *
 * One honest caveat about the sweep: this is a multi-page site, so clicking a
 * link tears down the current document and the replacement arrives already
 * rendered. On a fast connection the fill only exists for the few tens of
 * milliseconds before the page is swapped, so it reads as a brief flicker. It
 * comes into its own on a slow or flaky connection, which is when a loading
 * signal is worth anything. Making the sweep fully visible on every navigation
 * would mean adopting a client-side router.
 *
 * aria-hidden: browsers announce page loads to assistive tech themselves, so
 * this is decoration. Duplicating it in the accessibility tree adds noise.
 */
---

<div id="loading-bar" class="loading-bar" aria-hidden="true">
  <div class="loading-bar__fill"></div>
</div>

<style>
  .loading-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 200; /* above the skip link */
    height: 2px;
    /* The always-on state: present, but barely. */
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    pointer-events: none;
  }

  .loading-bar__fill {
    width: 0;
    height: 100%;
    background: var(--accent);
  }

  /*
    Starts at 15% rather than 0 so a click registers immediately instead of
    creeping up from nothing, then eases towards 92% and stops. It never
    completes on its own — the bar goes away because the new page replaced this
    one, which is the only completion signal we actually have.
  */
  .loading-bar.is-loading .loading-bar__fill {
    animation: loading-bar-advance 12s cubic-bezier(0, 0.75, 0.25, 1) forwards;
  }

  @keyframes loading-bar-advance {
    from {
      width: 15%;
    }
    to {
      width: 92%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Presence, not movement. */
    .loading-bar.is-loading .loading-bar__fill {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  import { startsPageLoad } from '../lib/nav-progress';

  const bar = document.getElementById('loading-bar');

  if (bar) {
    /** If a load is cancelled we never hear about it — don't leave the bar filled forever. */
    const GIVE_UP_AFTER_MS = 20_000;

    let giveUpTimer: number | undefined;

    function show() {
      bar!.classList.add('is-loading');
      window.clearTimeout(giveUpTimer);
      giveUpTimer = window.setTimeout(hide, GIVE_UP_AFTER_MS);
    }

    function hide() {
      window.clearTimeout(giveUpTimer);
      giveUpTimer = undefined;
      bar!.classList.remove('is-loading');
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      const link = target instanceof Element ? target.closest('a') : null;
      if (!link) return;

      if (
        startsPageLoad({
          href: link.href,
          from: window.location.href,
          target: link.getAttribute('target'),
          download: link.hasAttribute('download'),
          button: event.button,
          modified: event.metaKey || event.ctrlKey || event.shiftKey || event.altKey,
          defaultPrevented: event.defaultPrevented,
        })
      ) {
        show();
      }
    });

    /*
      A page restored from the back/forward cache comes back with the DOM it was
      frozen with — including a half-finished fill from the click that left it.
      pageshow fires on restore as well as first load, so this clears both.
    */
    window.addEventListener('pageshow', hide);
  }
</script>
