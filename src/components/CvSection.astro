---
/**
 * One band of the CV — the section name in the fixed left rail, its entries on
 * the right. Every band gets an id so a single part of the CV can be linked
 * directly: `khushibajaj.com/cv/#education`.
 */
import type { Section } from '../data/cv';

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<section class="cv-band" id={section.id}>
  <h2>{section.heading}</h2>
  <div>
    {
      section.entries.map((entry) => (
        <div class="cv-entry">
          <div class="cv-entry__main">
            <p class="cv-entry__title">
              {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
            </p>
            {entry.where && <p class="cv-entry__where">{entry.where}</p>}
            {entry.notes?.map((note) => <p class="cv-entry__where">{note}</p>)}
            {entry.dissertation && (
              <p class="cv-diss">
                <span class="cv-diss__label">Dissertation</span>
                <em>{entry.dissertation}</em>
              </p>
            )}
          </div>
          <p class="cv-entry__when">{entry.when}</p>
        </div>
      ))
    }
  </div>
</section>
