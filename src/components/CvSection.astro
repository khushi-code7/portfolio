---
/**
 * One block of the CV — a heading and its entries. Every section gets an id so
 * a single part of the CV can be linked directly: `khushibajaj.com/#education`.
 */
import type { Section } from '../data/cv';

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<section class="cv-section" id={section.id}>
  <h2>{section.heading}</h2>
  <ol class="cv-list">
    {
      section.entries.map((entry) => (
        <li class="cv-entry">
          <div class="cv-entry__main">
            <h3 class="cv-entry__title">
              {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
            </h3>
            {(entry.where || entry.result) && (
              <p class="cv-entry__where">
                {entry.where}
                {entry.where && entry.result && <span class="sep">·</span>}
                {entry.result && <span class="cv-entry__result">{entry.result}</span>}
              </p>
            )}
            {entry.notes?.map((note) => <p class="cv-entry__note">{note}</p>)}
          </div>
          <p class="cv-entry__when">{entry.when}</p>
        </li>
      ))
    }
  </ol>
</section>
