---
/**
 * One of the small square icon links under your name — the envelope and the
 * LinkedIn "in" from the sketch. Both are real links.
 *
 * Renders nothing at all when there is no href, so neither icon appears on the
 * site until you fill the address in.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** Read out by screen readers, and shown as the tooltip on hover. */
  label: string;
  icon: 'mail' | 'linkedin';
}

const { href, label, icon } = Astro.props;

// A profile on someone else's site opens in its own tab; mailto: must not, or
// the browser is left holding an empty window after the mail client opens.
const external = href.startsWith('http');
---

{
  href && (
    <a
      class="icon-link"
      href={href}
      aria-label={label}
      title={label}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <Icon name={icon} />
    </a>
  )
}
